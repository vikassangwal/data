generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// 1. AUTHENTICATION & USERS (NextAuth Core)
// ------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               String    @default("USER")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Custom SaaS Auth, recovery & lifecycle fields
  username           String?   @unique
  mobile             String?
  dateOfBirth        DateTime?
  gender             String?
  country            String?
  state              String?
  city               String?
  profession         String?
  organization       String?
  bio                String?
  planId             String    @default("trial")
  trialEndsAt        DateTime?
  termsAccepted      Boolean   @default(true)
  termsAcceptedDate  DateTime?
  resetOtp           String?
  resetOtpExpires    DateTime?
  emailChangeOtp        String?
  emailChangeOtpExpires DateTime?
  newEmailRequest       String?
  signupOtp             String?
  signupOtpExpires      DateTime?
  twoFactorSecret       String?
  twoFactorEnabled      Boolean   @default(false)

  accounts      Account[]
  sessions      Session[]
  
  // Relations
  workspaces    WorkspaceMember[]
  posts         BlogPost[]
  comments      Comment[]
  chatSessions  ChatSession[]
  leads         Lead[]            @relation("AssignedLeads")

  // Enterprise Tracking Relations
  loginHistory      LoginHistory[]
  userActivities    UserActivityLog[]
  auditLogs         AuditLog[]
  paymentLogs       PaymentLog[]
  subscriptionLogs  SubscriptionLog[]
  securityLogs      SecurityLog[]
  userIntegrations  UserIntegration[]
  enterpriseDbs     EnterpriseDatabase[]
  activeSessions    ActiveSession[]
  deviceHistory     DeviceHistory[]
  notifications     UserNotification[]
  privacySettings   PrivacySetting?
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// 12. ENTERPRISE TRACKING & PRIVACY SYSTEM (PHASE 9)
// ------------------------------------------------------

model LoginHistory {
  id              String   @id @default(cuid())
  userId          String
  loginTime       DateTime @default(now())
  logoutTime      DateTime?
  ipAddress       String?
  country         String?
  city            String?
  device          String?
  browser         String?
  os              String?
  sessionDuration Int?     // Duration in seconds
  status          String   // "SUCCESS", "FAILED"
  failedAttempts  Int      @default(0)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // e.g. "Dashboard Viewed", "File Uploaded"
  module      String   // e.g. "Dashboard", "Analytics", "Settings"
  resource    String?  // e.g. "Report-123"
  ipAddress   String?
  device      String?
  metadata    String?  // JSON string containing extra details
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // e.g. "Plan Changed", "Permission Updated"
  module      String   // e.g. "Billing", "Users"
  resource    String
  oldValue    String?  // JSON string
  newValue    String?  // JSON string
  details     String?
  ipAddress   String?
  device      String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PaymentLog {
  id              String   @id @default(cuid()) // Payment ID
  userId          String
  organizationId  String?
  invoiceId       String?
  planName        String
  amount          Float
  currency        String   @default("USD")
  taxAmount       Float    @default(0.0)
  discountAmount  Float    @default(0.0)
  gatewayUsed     String   // "Stripe", "Razorpay"
  transactionId   String   @unique
  paymentStatus   String   // "SUCCESS", "PENDING", "FAILED", "REFUNDED"
  paymentDate     DateTime @default(now())
  expiryDate      DateTime?
  renewalDate     DateTime?
  ipAddress       String?
  deviceInfo      String?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionLog {
  id              String   @id @default(cuid())
  userId          String
  action          String   // "ACTIVATED", "EXPIRED", "CANCELED", "UPGRADED"
  planName        String
  timestamp       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "PASSWORD_CHANGED", "2FA_ENABLED", "SUSPICIOUS_LOGIN"
  ipAddress   String?
  device      String?
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActiveSession {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  device      String?
  browser     String?
  os          String?
  ipAddress   String?
  lastActive  DateTime @default(now())
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceHistory {
  id          String   @id @default(cuid())
  userId      String
  device      String
  browser     String
  os          String
  ipAddress   String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  isTrusted   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   // "SECURITY", "BILLING", "SYSTEM"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PrivacySetting {
  id                    String   @id @default(cuid())
  userId                String   @unique
  shareDataWithPartners Boolean  @default(false)
  allowTelemetry        Boolean  @default(true)
  profileVisibility     String   @default("private") // "private", "public", "organization"
  marketingEmails       Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataRetentionPolicy {
  id            String   @id @default(cuid())
  logType       String   @unique // e.g. "LoginHistory", "AuditLog"
  retentionDays Int      @default(365) // 30, 90, 180, 365, etc.
  updatedAt     DateTime @updatedAt
}

// ------------------------------------------------------
// 2. CMS & PUBLIC CONTENT
// ------------------------------------------------------

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("My Platform")
  maintenanceMode Boolean  @default(false)
  showPublicReviews Boolean @default(true)
  theme           String   @default("dark")
  contactEmail    String?
  seoTitle        String?
  seoDesc         String?
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features    ServiceFeature[]
  pricing     ServicePricing?
}

model ServiceFeature {
  id        String  @id @default(cuid())
  serviceId String
  title     String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServicePricing {
  id        String  @id @default(cuid())
  serviceId String  @unique
  basePrice Float
  currency  String  @default("USD")
  type      String  // "fixed", "hourly", "subscription"
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  price       String
  period      String
  isPopular   Boolean  @default(false)
  order       Int      @default(0)
  basePrice   Float    @default(0.0)
  discount    Float    @default(0.0)
  isActive    Boolean  @default(true)
  features    PricingFeature[]
  planFeatures PlanFeature[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingFeature {
  id            String      @id @default(cuid())
  pricingPlanId String
  title         String
  plan          PricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  challenge   String?
  solution    String?
  results     String?
  liveUrl     String?
  githubUrl   String?
  gradient    String?
  imageUrl    String?  // Added for Phase 3
  seoTitle    String?  // Added for Phase 3
  seoDesc     String?  // Added for Phase 3
  seoKeywords String?  // Added for Phase 3
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metrics     ProjectMetric[]
  tags        ProjectTag[]
}

model ProjectMetric {
  id        String  @id @default(cuid())
  projectId String
  label     String
  value     Float
  suffix    String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectTag {
  id        String  @id @default(cuid())
  name      String
  projects  Project[]
}

// ------------------------------------------------------
// 3. BLOG & CONTENT
// ------------------------------------------------------

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  imageUrl    String?  // Added for Phase 3
  seoTitle    String?  // Added for Phase 3
  seoDesc     String?  // Added for Phase 3
  seoKeywords String?  // Added for Phase 3
  published   Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User      @relation(fields: [authorId], references: [id])
  comments    Comment[]
  categories  BlogCategory[]
}

model BlogCategory {
  id    String @id @default(cuid())
  name  String @unique
  posts BlogPost[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isApproved Boolean @default(true)

  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
}

// ------------------------------------------------------
// 4. CRM & LEADS
// ------------------------------------------------------

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  message     String?
  status      String   @default("NEW")
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee    User?    @relation("AssignedLeads", fields: [assignedTo], references: [id])
  notes       LeadNote[]
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 5. ANALYTICS LAB
// ------------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  datasets    Dataset[]
  dashboards  Dashboard[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   // "owner", "editor", "viewer"

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Dataset {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  filePath    String
  rowCount    Int?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
}

model Analysis {
  id          String   @id @default(cuid())
  datasetId   String
  query       String?
  result      String?
  codeSnippet String?
  createdAt   DateTime @default(now())

  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model Dashboard {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  config      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 6. AI & MISC
// ------------------------------------------------------

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  startedAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user", "assistant"
  content   String
  createdAt DateTime @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 7. UNIVERSAL AI PROVIDER MANAGEMENT SYSTEM
// ------------------------------------------------------

model AiProvider {
  id             String   @id @default(cuid())
  name           String   // e.g. "OpenAI", "Custom API"
  type           String   // "openai_compatible", "gemini", "claude"
  apiKey         String
  baseUrl        String?
  endpointUrl    String?
  models         String   // JSON array of detected models
  isActive       Boolean  @default(false)
  isFallback     Boolean  @default(false)
  temperature    Float    @default(0.7)
  maxTokens      Int      @default(2048)
  timeoutMs      Int      @default(30000)
  retryCount     Int      @default(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  agents         AiAgent[]
  logs           AiApiLog[]
}

model AiRoutingRule {
  id             String   @id @default(cuid())
  taskType       String   // e.g. "coding", "fast_response", "research"
  providerId     String
  createdAt      DateTime @default(now())
}

model AiAgent {
  id             String   @id @default(cuid())
  name           String
  role           String
  systemPrompt   String
  memoryEnabled  Boolean  @default(false)
  providerId     String
  provider       AiProvider @relation(fields: [providerId], references: [id])
}

model AiApiLog {
  id             String   @id @default(cuid())
  providerId     String
  provider       AiProvider @relation(fields: [providerId], references: [id])
  endpoint       String
  tokensUsed     Int
  cost           Float
  status         Int      // 200, 500
  responseTimeMs Int
  createdAt      DateTime @default(now())
}

// ------------------------------------------------------
// 8. DATA UPLOAD & DATASET MANAGEMENT MODULE
// ------------------------------------------------------

model AdminDataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  tags        String?  // comma separated
  sourceType  String   // "file", "url", "sql", "s3"
  purpose     String?  // "rag", "analytics", "training"
  visibility  String   @default("private")
  status      String   @default("pending") // pending, processing, ready, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files       DataFile[]
  vectorIndexes VectorIndex[]
}

model DataFile {
  id            String   @id @default(cuid())
  datasetId     String
  fileName      String
  fileType      String   // "csv", "pdf", "json", etc
  filePath      String   // Path in storage
  fileSize      Int
  extractedText String?
  createdAt     DateTime @default(now())

  dataset       AdminDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model DataSourceConnection {
  id            String   @id @default(cuid())
  name          String
  provider      String   // "postgres", "s3", "gdrive", "supabase"
  credentials   String   // Encrypted connection string or JSON
  status        String   @default("connected")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VectorIndex {
  id            String   @id @default(cuid())
  datasetId     String
  provider      String   // "pinecone", "chroma", "sqlite"
  indexName     String
  vectorCount   Int      @default(0)
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dataset       AdminDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model DataPipelineJob {
  id            String   @id @default(cuid())
  jobType       String   // "chunking", "embedding", "cleaning"
  targetId      String   // ID of dataset or file
  status        String   @default("queued") // queued, running, completed, failed
  logs          String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
}

// ------------------------------------------------------
// 9. HOMEPAGE DYNAMIC CMS
// ------------------------------------------------------

model HeroSetting {
  id          String   @id @default(cuid())
  badgeText   String   @default("AI-Powered Digital Solutions")
  titlePrefix String   @default("Your Intelligence Hub for")
  typewriter  String   // JSON array e.g. ["Data Insights", "AI Automation"]
  description String   @default("We turn complex data into clarity...")
  cta1Text    String   @default("Start a Project")
  cta1Link    String   @default("/contact")
  cta2Text    String   @default("View Our Work")
  cta2Link    String   @default("/projects")
  updatedAt   DateTime @updatedAt
}

model Statistic {
  id          String   @id @default(cuid())
  value       Int
  suffix      String?  // e.g. "+" or "%"
  label       String
  color       String   @default("#3B82F6")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  quote       String
  rating      Int      @default(5)
  avatar      String?  // Initials or image URL
  color       String   @default("#3B82F6")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
}

model TimelineEvent {
  id          String   @id @default(cuid())
  icon        String   // Emoji or identifier
  text        String
  timeAgo     String   // e.g. "2d ago"
  color       String   @default("#3B82F6")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
}

model SkillLevel {
  id          String   @id @default(cuid())
  label       String
  value       Int      // 0 to 100
  color       String   @default("#3B82F6")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
}

// ------------------------------------------------------
// 10. ADVANCED CMS PAGES (PHASE 3)
// ------------------------------------------------------

model AboutPageSetting {
  id          String   @id @default(cuid())
  title       String   @default("About Us")
  subtitle    String?
  content     String   // Full HTML or Markdown content
  imageUrl    String?
  mission     String?
  vision      String?
  updatedAt   DateTime @updatedAt
}

model ResumeEntry {
  id          String   @id @default(cuid())
  type        String   // "experience", "education", "certification"
  title       String
  organization String
  location    String?
  startDate   String
  endDate     String?  // "Present" if null or specific
  description String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
}

model ContactPageSetting {
  id          String   @id @default(cuid())
  title       String   @default("Get In Touch")
  description String?
  email       String
  phone       String?
  address     String?
  mapUrl      String?
  socialLinks String?  // JSON string
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// 6. ANALYTICS (Site Traffic)
// ------------------------------------------------------

model PageView {
  id        String   @id @default(cuid())
  path      String
  userAgent String?
  country   String?
  ipHash    String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// 11. SaaS DYNAMIC PLAN FEATURE GATES
// ------------------------------------------------------

model Feature {
  code        String   @id
  name        String
  description String?
  plans       PlanFeature[]
}

model PlanFeature {
  planId      String
  featureCode String
  
  plan        PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature     Feature  @relation(fields: [featureCode], references: [code], onDelete: Cascade)

  @@id([planId, featureCode])
}

model SystemSetting {
  key         String   @id // e.g. "STRIPE_SECRET_KEY"
  value       String   // Encrypted API key
  updatedAt   DateTime @updatedAt
}

model ErrorLog {
  id          String   @id @default(cuid())
  message     String
  stackTrace  String
  codeSnippet String?
  filePath    String?
  rootCause   String?
  explanation String?
  fixedCode   String?
  status      String   @default("UNRESOLVED") // "UNRESOLVED", "RESOLVED", "APPLIED"
  createdAt   DateTime @default(now())
}

model AdminAlert {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String   // "info", "warning", "critical"
  datasetId   String?
  source      String   @default("ml-scanner")
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiIntegration {
  id           String   @id @default(cuid())
  providerName String   @unique // e.g., "openai", "stripe"
  apiKey       String
  baseUrl      String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
}

model AiWorkflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  nodesData   String   // JSON string of react-flow nodes
  edgesData   String   // JSON string of react-flow edges
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ResumeProfileSetting {
  id          String   @id @default(cuid())
  name        String   @default("Alex Kumar")
  initials    String   @default("AK")
  title       String   @default("Data Analyst · AI Engineer · Full-Stack Developer")
  bio         String   @default("7+ years transforming data into intelligence...")
  photoUrl    String?
  cvUrl       String?
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// 13. AI/ML ENGINE (Phase 1)
// ------------------------------------------------------

model TrainedModel {
  id          String   @id @default(cuid())
  name        String
  datasetId   String
  modelType   String   // "linear_regression", "random_forest", "decision_tree", "knn", "logistic_regression"
  targetCol   String
  featureCols String?  // JSON array of feature column names
  accuracy    Float?
  metrics     String?  // JSON: {r2, mae, mse, confusionMatrix, featureImportance}
  modelData   String?  // Serialized model weights/config (JSON)
  status      String   @default("training") // "training", "ready", "failed"
  trainedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InsightReport {
  id          String   @id @default(cuid())
  datasetId   String
  insights    String   // JSON array of InsightCard objects
  summary     String?  // Natural language executive summary
  score       Float?   // Overall data health score 0-100
  status      String   @default("generating") // "generating", "ready", "failed"
  createdAt   DateTime @default(now())
}

model PredictionJob {
  id          String   @id @default(cuid())
  datasetId   String
  targetCol   String
  horizon     Int      @default(6) // periods to predict
  method      String   @default("linear") // "linear", "moving_avg", "exponential"
  results     String?  // JSON: {predictions, confidence, historicalData}
  accuracy    Float?
  status      String   @default("running") // "running", "completed", "failed"
  createdAt   DateTime @default(now())
}

model CleaningJob {
  id          String   @id @default(cuid())
  datasetId   String
  issues      String?  // JSON array of detected issues
  fixes       String?  // JSON array of applied fixes
  stats       String?  // JSON: {before: {rows, nulls, dupes}, after: {...}}
  status      String   @default("scanning") // "scanning", "review", "applied", "failed"
  createdAt   DateTime @default(now())
}

model UserIntegration {
  id                 String   @id @default(cuid())
  userId             String
  provider           String   // e.g., "shopify", "google_analytics", "facebook_ads", "stripe", "salesforce"
  providerAccountId  String?  // External ID for the connected account
  accessToken        String?  // Encrypted access token
  refreshToken       String?  // Encrypted refresh token
  scopes             String?  // Granted scopes
  metadata           String?  // Additional data (JSON)
  status             String   @default("active") // "active", "expired", "revoked", "error"
  lastSyncAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model EnterpriseDatabase {
  id                 String   @id @default(cuid())
  userId             String
  name               String   // User-friendly name for the connection
  engine             String   // e.g., "postgresql", "mysql", "mongodb", "snowflake"
  host               String
  port               Int?
  databaseName       String
  username           String?
  passwordEncrypted  String?  // Encrypted password/credential
  sslMode            String   @default("prefer")
  status             String   @default("connected") // "connected", "failed", "syncing"
  lastSyncAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// 14. AUTOMATED LEAD GEN & SEO AUDIT
// ------------------------------------------------------

model LeadAudit {
  id              String   @id @default(cuid())
  url             String
  scrapedContent  String?  // Raw text or HTML
  metaTags        String?  // JSON string
  seoReport       String?  // JSON structured report
  status          String   @default("PENDING") // PENDING, SCRAPED, AUDITED, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  emails          OutreachEmail[]
}

model OutreachEmail {
  id              String   @id @default(cuid())
  auditId         String
  subject         String
  body            String
  targetEmail     String?
  status          String   @default("DRAFT") // DRAFT, SENT, FAILED
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  audit           LeadAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}
