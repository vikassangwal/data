    "cheerio": "^1.2.0",
    "chromadb": "^3.4.3",
    "framer-motion": "^12.39.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
